<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ObjPoser</RootNamespace>
    <AssemblyName>ObjPoser</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <OutputPath>bin\Release\</OutputPath>
    <Optimize>true</Optimize>
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Core.cs" />
    <Compile Include="Skeleton.cs" />
    <Compile Include="Pose.cs" />
    <Compile Include="Skinner.cs" />
    <Compile Include="Export.cs" />
    <Compile Include="Textures.cs" />
    <Compile Include="UI.cs" />
    <Compile Include="ThirdParty\TGASharpLib.cs" />
    <Compile Include="ThirdParty\DDSReaderSharp.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\poses\*.json">
      <Link>poses\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
